# Public Sui configuration only. Never put a private key or recovery phrase here.
SUI_NETWORK=testnet
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
TALI_PACKAGE_ID=0x7be8aa82872facbd01372cdeb20375a82f74011dca1512e41737664a759dc523
TALI_COIN_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
TALI_MANDATE_ID=0x16b9fdc16764d6fa514fb6da55df5ca840d30e5bb057eba6a5ab67cf743c7f6f

# Web app. Anything prefixed NEXT_PUBLIC_ is inlined into the client bundle.
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
NEXT_PUBLIC_PACKAGE_ID=0x7be8aa82872facbd01372cdeb20375a82f74011dca1512e41737664a759dc523
NEXT_PUBLIC_COIN_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
NEXT_PUBLIC_MANDATE_ID=0x16b9fdc16764d6fa514fb6da55df5ca840d30e5bb057eba6a5ab67cf743c7f6f
NEXT_PUBLIC_AGENT_ADDRESS=0x939194a716226335b1089c5b36088ebc0b57a928c206d63c9ddcad70ff76b471
NEXT_PUBLIC_DEMO_EVENT_ID=ba7e50e2-7e7b-4a67-a505-9e3a329739ae
NEXT_PUBLIC_PAYROLL_MANDATE_ID=
NEXT_PUBLIC_DEMO_STREAM_ID=

# Server only. Never prefix these with NEXT_PUBLIC_.
# Exact browser origin used for CSRF/origin enforcement and Secure cookie policy.
TALI_APP_ORIGIN=http://localhost:3000
# Testnet backend signer only. Use a Sui suiprivkey value; never commit it.
# Automated tests do not read or broadcast with this key.
AGENT_PRIVATE_KEY=
# Owned AgentCap object for the derived backend signer address.
AGENT_CAP_ID=
ADMIN_CAP_ID=

# Payroll. Every one of these must be set before a run can be signed; the app
# refuses to sign with a half-configured mandate rather than pay part of one.
# The payroll module ships as a package upgrade, so it has its own address.
PAYROLL_PACKAGE_ID=
PAYROLL_MANDATE_ID=
# Holder of this cap can both run payroll and revoke the mandate. Server only.
PAYROLL_CAP_ID=
# Wallet authorized to run payroll, revoke mandates, and submit safety tests.
# Server-only; never prefix with NEXT_PUBLIC_.
TALI_EMPLOYER_WALLET=
# Testnet addresses standing in for the three statutory bodies. Order matters:
# the contract pairs each amount with the recipient at the same index.
PAYROLL_EPF_ADDRESS=
PAYROLL_SOCSO_ADDRESS=
PAYROLL_EIS_ADDRESS=
# The salary stream the earnings screen reads.
DEMO_STREAM_ID=

SUPABASE_URL=
# Preferred server credential for new Supabase projects.
SUPABASE_SECRET_KEY=
# Temporary fallback for projects that still expose the legacy name.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_RECEIPT_BUCKET=receipts

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

AUTO_PAY_CONFIDENCE_THRESHOLD=0.9

# Local/demo compatibility only. Always leave false on hosted deployments.
TALI_ALLOW_INSECURE_DEMO_IDENTITY=false
